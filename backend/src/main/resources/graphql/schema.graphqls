type Query {
  echoHome: EchoHome!
  teacherLessons: [TeacherLesson!]!
  "The signed-in learner's phrase cards for their current language, due cards first."
  echoCards: [EchoCard!]!
  "The signed-in person's own details. Shared by all Deepwater products; never shown to other people."
  myProfile: PersonProfile!
}

type Mutation {
  startEcho(goal: String!, languageCode: String!, selfReportedLevel: String!): EchoHome!
  chooseEchoLanguage(languageCode: String!): EchoHome!
  submitEchoPractice(exerciseId: ID!, answer: String!, transferSelfCheck: Boolean): PracticeResult!
  submitEchoAudioEvidence(lessonId: ID!, taskType: String!, answer: String!, transcriptUsed: Boolean!, confidence: Int!): AudioPracticeResult!
  saveEchoLessonDraft(input: LessonDraftInput!): TeacherLesson!
  publishEchoLesson(lessonId: ID!): TeacherLesson!
  unpublishEchoLesson(lessonId: ID!): TeacherLesson!
  saveEchoCard(front: String!, back: String!, lessonId: ID): EchoCard!
  "knewIt moves the card up one box; a miss moves it down one box, never back to the start."
  reviewEchoCard(cardId: ID!, knewIt: Boolean!): EchoCard!
  deleteEchoCard(cardId: ID!): Boolean!
  updateMyProfile(input: PersonProfileInput!): PersonProfile!
}

input LessonDraftInput {
  revisionOf: ID
  languageCode: String!
  title: String!
  level: String!
  topic: String!
  objective: String!
  explanation: String!
  sourceReference: String!
  skillKey: String!
  sortOrder: Int
  exercises: [ExerciseDraftInput!]!
  audio: AudioLessonDraftInput
}
input AudioLessonDraftInput {
  mediaType: String!
  sourceTitle: String!
  creator: String!
  sourceUrl: String!
  playbackUrl: String
  editorialBand: String!
  topicTags: String!
  speechRate: Int!
  vocabularyDensity: Int!
  idiomDensity: Int!
  pronunciationLoad: Int!
  topicFamiliarity: Int!
  beforeListeningPrompt: String!
  gistPrompt: String!
  focusPrompt: String!
  transcriptText: String
  rightsBasis: String!
  linkAllowed: Boolean!
  playbackAllowed: Boolean!
  transcriptAllowed: Boolean!
  rightsReference: String!
  rightsExpiresAt: String
}
input ExerciseDraftInput {
  taskType: String!
  prompt: String!
  expectedAnswer: String
  acceptedAnswers: [String!]
  feedbackCorrect: String
  feedbackIncorrect: String
  options: [ExerciseOptionInput!]
}
input ExerciseOptionInput { key: String!, text: String! }

type EchoHome {
  onboarded: Boolean!
  profile: EchoLearnerProfile
  nextAction: String!
  lessons: [EchoLesson!]!
  totalAttempts: Int!
  correctAttempts: Int!
  audioAttempts: Int!
  recommendedAudioLessonId: ID
  recommendedAudioReason: String!
}

type EchoLearnerProfile {
  goal: String!
  selfReportedLevel: String!
  languageCode: String!
  diagnosticScore: Int!
  startingRoute: String!
}
type TeacherLesson {
  id: ID!
  languageCode: String!
  title: String!
  level: String!
  topic: String!
  objective: String!
  explanation: String!
  sourceReference: String!
  skillKey: String!
  reviewStatus: String!
  version: Int!
  revisionOf: ID
  exercises: [TeacherExercise!]!
  audio: TeacherAudioLesson
}
type TeacherAudioLesson {
  mediaType: String!
  sourceTitle: String!
  creator: String!
  sourceUrl: String!
  playbackUrl: String
  editorialBand: String!
  topicTags: String!
  speechRate: Int!
  vocabularyDensity: Int!
  idiomDensity: Int!
  pronunciationLoad: Int!
  topicFamiliarity: Int!
  beforeListeningPrompt: String!
  gistPrompt: String!
  focusPrompt: String!
  transcriptAllowed: Boolean!
  transcriptText: String
  rightsBasis: String!
  linkAllowed: Boolean!
  playbackAllowed: Boolean!
  rightsReference: String!
  rightsExpiresAt: String
}
type TeacherExercise {
  position: Int!
  taskType: String!
  prompt: String!
  expectedAnswer: String
  acceptedAnswers: [String!]!
  feedbackCorrect: String!
  feedbackIncorrect: String!
  options: [EchoExerciseOption!]!
}

type EchoLesson {
  id: ID!
  title: String!
  level: String!
  topic: String!
  objective: String!
  explanation: String!
  sourceReference: String!
  contentStatus: String!
  mastery: Float!
  attempts: Int!
  nextReviewAt: String
  due: Boolean!
  exercises: [EchoExercise!]!
  audio: EchoAudioLesson
}
type EchoAudioLesson {
  mediaType: String!
  sourceTitle: String!
  creator: String!
  sourceUrl: String!
  playbackUrl: String
  editorialBand: String!
  topicTags: String!
  speechRate: Int!
  vocabularyDensity: Int!
  idiomDensity: Int!
  pronunciationLoad: Int!
  topicFamiliarity: Int!
  beforeListeningPrompt: String!
  gistPrompt: String!
  focusPrompt: String!
  transcriptAllowed: Boolean!
  transcriptText: String
  rightsExpiresAt: String
}

type EchoExercise {
  id: ID!
  position: Int!
  taskType: String!
  prompt: String!
  options: [EchoExerciseOption!]!
  lastCorrect: Boolean
}

type EchoExerciseOption {
  key: String!
  text: String!
}

type PracticeResult {
  exerciseId: ID!
  answer: String!
  graded: Boolean!
  correct: Boolean
  feedback: String!
  "A tentative, rule-based suggestion for a near miss on a typed answer."
  hint: String
  mastery: Float!
  nextReviewAt: String
  transfer: Boolean!
}
type AudioPracticeResult {
  saved: Boolean!
  taskType: String!
  transcriptUsed: Boolean!
  confidence: Int!
  nextTaskType: String!
  repeatSuggested: Boolean!
  feedback: String!
}

type EchoCard {
  id: ID!
  front: String!
  back: String!
  lessonId: ID
  "0 = new or missed, 5 = well known."
  box: Int!
  nextReviewAt: String!
  due: Boolean!
}

type PersonProfile {
  name: String!
  email: String!
  emailVerified: Boolean!
  phone: String
  city: String
  country: String
  nativeLanguage: String
  about: String
}
input PersonProfileInput {
  name: String!
  phone: String
  city: String
  country: String
  nativeLanguage: String
  about: String
}
